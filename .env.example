# Configuración SMTP para recuperación de credenciales.
# Use una contraseña de aplicación de Google, nunca la contraseña principal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=administracion.lyflowers@gmail.com
EMAIL_HOST_PASSWORD=COLOQUE_AQUI_LA_CONTRASENA_DE_APLICACION
DEFAULT_FROM_EMAIL=Seguridad L.Y Flowers <administracion.lyflowers@gmail.com>
PASSWORD_RECOVERY_EMAIL=administracion.lyflowers@gmail.com

# URL interna del servicio Redis de Railway. Déjela vacía en desarrollo local.
VALKEY_URL=${{Redis.REDIS_URL}}

# Producción Django / Railway
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=GENERE_UNA_CLAVE_ALEATORIA_LARGA_Y_UNICA
# Railway añade automáticamente RAILWAY_PUBLIC_DOMAIN. Estas dos variables
# solo son necesarias si posteriormente conecta un dominio propio.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Referencia privada al servicio PostgreSQL creado dentro del mismo proyecto.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway crea esta variable al montar un volumen. Monte el volumen en /app/media.
# No necesita escribirla manualmente en Railway.
RAILWAY_VOLUME_MOUNT_PATH=/app/media

# Alternativa exclusivamente para desarrollo si no utiliza local_settings.py
DB_NAME=LYF
DB_USER=postgres
DB_PASSWORD=CONTRASENA_LOCAL
DB_HOST=localhost
DB_PORT=5433
